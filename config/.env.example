# Copy to .env in the project root and fill in. NEVER commit .env to git.

# ---- Groww (recommended for full automation) ----
# Groww app/web -> Trading APIs -> create an API key of type "TOTP".
# GROWW_TOTP_SECRET is the base32 secret shown when you set up the TOTP key
# (the same secret you'd put into an authenticator app).
GROWW_API_KEY=
GROWW_TOTP_SECRET=
# alternative: "approval" type key instead of TOTP
# GROWW_API_SECRET=

# ---- Zerodha Kite Connect (needs a one-tap login every morning) ----
KITE_API_KEY=
KITE_API_SECRET=

# ---- WhatsApp alerts ----
# Your number with country code, e.g. +9198XXXXXXXX
WHATSAPP_PHONE=
# CallMeBot (free): send "I allow callmebot to send me messages" to +34 644 66 32 62 on WhatsApp
CALLMEBOT_API_KEY=
# or Meta WhatsApp Cloud API (whatsapp_provider: meta)
# META_WA_TOKEN=
# META_WA_PHONE_NUMBER_ID=

# ---- live trading safety latch ----
# Only set to YES after backtest acceptance + paper trading + preflight.
SWINGBOT_CONFIRM_LIVE=NO
